# Timesheet Production Env Template (copy -> .env.production or Azure App Settings)
## ---------------------------------------------------------------------------
## Interactive Web App (NextAuth) - Delegated permissions
## ---------------------------------------------------------------------------
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://<your-prod-domain>

## Optional custom scope (rarely needed)
AZURE_AD_APP_SCOPE=

## Group Claims (Security Groups Object IDs)
ADMIN_GROUP_ID=
CONSULTANT_GROUP_ID=
CONTRIBUTOR_GROUP_ID=${CONSULTANT_GROUP_ID}
VIEWER_GROUP_ID=

## ---------------------------------------------------------------------------
## Dataverse Server-to-Server (Application User) - Application permissions
## Separate App Registration credentials
## ---------------------------------------------------------------------------
DATAVERSE_ENABLED=true
DATAVERSE_URL=
DATAVERSE_TENANT_ID=${AZURE_AD_TENANT_ID}
DATAVERSE_CLIENT_ID=
DATAVERSE_CLIENT_SECRET=
# DATAVERSE_SCOPE=

## Optional entity/field overrides (uncomment only if needed)
# DATAVERSE_ENTITY_CONSULTANT=tt_users
# DATAVERSE_FIELD_CONSULTANT_AAD_OID=azureactivedirectoryobjectid
# DATAVERSE_ENTITY_PROJECT=tt_projects
# DATAVERSE_ENTITY_PROJECTUSER=tt_projectusers
# DATAVERSE_ENTITY_TIMEREGISTER=tt_timeregisters
# DATAVERSE_ENTITY_DAYSOFF=tt_daysoffs

## Runtime / Behavior
LOG_MODE=console
VOLATILE_STORE_PERSIST=false
NEXTAUTH_EMBED_GROUPS_IN_JWT=false
NEXT_PUBLIC_USE_MOCK=false
TIMESHEET_IMPERSONATION_ENABLED=true

