## Environment variables example
# Force mock data (true/false). On Azure keep true until Dataverse implemented.
NEXT_PUBLIC_USE_MOCK=true

# (Optional) Custom port for Next.js dev (we enforce 3000 via script, this is fallback)
# PORT=3000

# Add future API keys or connection strings below (never commit real secrets):
# DATAVERSE_URL=
# DATAVERSE_CLIENT_ID=